# Configurações de E-mail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=seu_email@gmail.com
EMAIL_PASSWORD=sua_senha_de_app_gmail
EMAIL_USE_TLS=True
EMAIL_FROM=seu_email@gmail.com
EMAIL_TO=destinatario1@dominio.com,destinatario2@dominio.com
EMAIL_CC=copia@dominio.com

# Provedor de sumarização: 'gemini' (em uso) ou 'ollama' (modelo local)
SUMMARIZER_PROVIDER=gemini

# Ollama API (modelo local) - usado se SUMMARIZER_PROVIDER=ollama
OLLAMA_API_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=mistral

# Google Gemini API - usado se SUMMARIZER_PROVIDER=gemini
# Obtenha sua chave em: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=sua_chave_api_google_ai_studio
GEMINI_MODEL=gemini-2.5-flash

# Anthropic Claude API - usado para síntese do dia
# Obtenha sua chave em: https://console.anthropic.com/
ANTHROPIC_API_KEY=sua_chave_api_anthropic

# Configurações Gerais
# Define o que é "ontem" para o boletim: as fontes são indianas, então o padrão
# é o fuso da Índia, independente de onde a máquina esteja.
TIMEZONE=Asia/Kolkata
# Caminho do log. LOG_LEVEL não é lido por nada no código.
LOG_PATH=logs/notas.log
 